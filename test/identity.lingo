-- Based path induction
basedPathInduction : {A : U} -> {a : A} -> (C : (b : A) -> a = b -> U) -> (c : C a refl) -> (b : A) -> (p : a = b) -> C b p
basedPathInduction C c b p := ind[=[A]](a. b. p. (C : (b : A) -> a = b -> U) -> C a refl -> C b p, z. \C. \d. d, a, b, p) C c

-- Identity Equivalence Relation
idRefl : {A : U} -> (a : A) -> a = a
idRefl a := refl

#type idRefl

idSymm : {A : U} -> {a, b : A} -> a = b -> b = a
idSymm := pInv

#type idSymm

idTrans : {A : U} -> {a, b, c : A} -> a = b -> b = c -> a = c
idTrans := pCat

#type idTrans

lPathId : {A : U} -> {a, b : A}  -> (p : a = b) -> idTrans refl p = p
lPathId p := ind[=[A]](a. b. p. idTrans refl p = p, z. refl[refl[z]], a, b, p)

#type lPathId

rPathId : {A : U} -> {a, b : A}  -> (p : a = b) -> idTrans p refl = p
rPathId p := ind[=[A]](a. b. p. idTrans p refl = p, z. refl[refl[z]], a, b, p)

#type rPathId

reflInv : {A : U} -> (a : A) -> pInv refl[a] = refl[a]
reflInv a := refl 

#type reflInv

lPathInv : {A : U} -> {a, b : A} -> (p : a = b) -> pCat (pInv p) p = refl
lPathInv p := ind[=[A]](a. b. p. idTrans (pInv p) p = refl, z. refl[refl[z]], a, b, p)

#type lPathInv

rPathInv : {A : U} -> {a, b : A} -> (p : a = b) -> pCat p (pInv p) = refl
rPathInv p := ind[=[A]](a. b. p. idTrans p (pInv p) = refl, z. refl[refl[z]], a, b, p)

#type rPathInv

pathInvInv : {A : U} -> {a, b : A} -> (p : a = b) -> pInv (pInv p) = p
pathInvInv p := ind[=[A]](a. b. p. pInv (pInv p) = p, z. refl[refl[z]], a, b, p)

#type pathInvInv

pathAssocLemma2 : {A : U} -> (c, d : A) -> (r : c = d) -> pCat refl (pCat refl r) = pCat refl r
pathAssocLemma2 c d r := ind[=[A]](c. d. r. pCat refl (pCat refl r) = pCat refl r, z. refl, c, d, r)

pathAssocLemma1 : {A : U} -> (a, c : A) -> (q : a = c) -> (d : A) -> (r : c = d) -> pCat refl (pCat q r) = pCat (pCat refl q) r
pathAssocLemma1 a c q := ind[=[A]](a. c. q. (d : A) -> (r : c = d) -> pCat refl (pCat q r) = pCat (pCat refl q) r, z. pathAssocLemma2 z, a, c, q)

pathAssocLemma : {A : U} -> {a, b : A} -> (p : a = b) -> (c : A) -> (q : b = c) -> (d : A) -> (r : c = d) -> pCat p (pCat q r) = pCat (pCat p q) r
pathAssocLemma p := ind[=[A]](a. b. p. (c : A) -> (q : b = c) -> (d : A) -> (r : c = d) -> pCat p (pCat q r) = pCat (pCat p q) r, z. pathAssocLemma1 z, a, b, p)

pathAssoc : {A : U} -> {a, b, c, d : A} -> (p : a = b) -> (q : b = c) -> (r : c = d) -> pCat p (pCat q r) = pCat (pCat p q) r
pathAssoc p q := pathAssocLemma p c q d

#type pathAssoc

apRefl : {A, B : U} -> (f : A -> B) -> (a : A) -> ap f refl[a] = refl[f a]
apRefl f a := refl

#type apRefl

apCatLemma1 : {A, B : U} -> (a, c : A) -> (q : a = c) -> (f : A -> B) -> ap f (pCat refl q) = pCat refl (ap f q)
apCatLemma1 a c q := ind[=[A]](a. c. q. (f : A -> B) -> ap f (pCat refl q) = pCat refl (ap f q), z. \f. refl, a, c, q)

apCatLemma : {A, B : U} -> {a, b : A} -> (p : a = b) -> (c : A) -> (q : b = c) -> (f : A -> B) -> ap f (pCat p q) = pCat (ap f p) (ap f q)
apCatLemma p := ind[=[A]](a. b. p. (c : A) -> (q : b = c) -> (f : A -> B) -> ap f (pCat p q) = pCat (ap f p) (ap f q), z. apCatLemma1 z, a, b, p)

apCat : {A, B : U} -> {a, b, c : A} -> (p : a = b) -> (q : b = c) -> (f : A -> B) -> ap f (pCat p q) = pCat (ap f p) (ap f q)
apCat p q := apCatLemma p c q

#type apCat

apInv : {A, B : U} -> {a, b : A} -> (p : a = b) -> (f : A -> B) -> ap f (pInv p) = pInv (ap f p)
apInv p := ind[=[A]](a. b. p.  (f : A -> B) -> ap f (pInv p) = pInv (ap f p), z. \f. refl, a, b, p)

#type apInv

-- Identity on type constructors
productPath : {A, B : U} -> (a, b : A x B) -> (p : a = b) -> (fst a = fst b)
productPath a b p := ap fst p

#type productPath

productUniqueness : {A, B : U} -> (z : A x B) -> z = (fst z, snd z)
productUniqueness (a, b) := refl

#type productUniqueness
