happly : {A, B : U} -> (f, g : A -> B) -> f = g -> (a : A) -> f a = g a
happly f g p a := ind[=[A -> B]](f. g. p'. f a = g a, z. refl, f, g, p)

fun1 : T -> T
fun2 : T -> T

fun1PointwiseEqualsFun2 : (a : T) -> fun1 a = fun2 a
fun1PointwiseEqualsFun2 a := idTrans (uniqT (fun1 a)) (idSymm (uniqT (fun2 a)))

fun1EqualsFun2 : fun1 = fun2
fun1EqualsFun2 := funext fun1PointwiseEqualsFun2

#type fun1EqualsFun2

-- Example term demonstrating that canonicity fails when adding the funext axiom
noCanonicity : Nat
noCanonicity := ind[=[T -> T]](a. b. p. Nat, z. 0, fun1, fun2, fun1EqualsFun2)

#check noCanonicity

-- Homotopy equivalence relation
homotopyRefl : {A, B : U} -> (f : A -> B) -> homotopic f f
homotopyRefl f a := refl

#type homotopyRefl

homotopySymm : {A, B : U} -> (f , g : A -> B) -> homotopic f g -> homotopic g f
homotopySymm f g hfg a := idSymm (hfg a)

#type homotopySymm

homotopyTrans : {A, B : U} -> (f, g, h : A -> B) -> homotopic f g -> homotopic g h -> homotopic f h
homotopyTrans f g h hfg hgh a := idTrans (hfg a) (hgh a)

#type homotopyTrans

-- Quasi-inverse
qinv : {A, B : U} -> (f : A -> B) -> U
qinv f := (g : B -> A) x (homotopic (comp f g) id) x (homotopic (comp g f) id)

#eval qinv

idSelfInverse : {A : U} -> qinv (id {A})
idSelfInverse := (id, \a. refl, \a. refl)

#type idSelfInverse

isqequiv : (A, B : U) -> U
isqequiv A B := (f : A -> B) x (qinv f)

isqequivRefl : (A : U) -> isqequiv A A
isqequivRefl A := (id, idSelfInverse)

#type isqequivRefl

-- Formalised from Theorem 2.8.1 in HoTT book

allUnitEq : (a, b : T) -> T -> a = b
allUnitEq * * u := refl

unitPathEquivLemma : {a, b : T} -> (p : a = b) -> allUnitEq a b * = p
unitPathEquivLemma p := ind[=[T]](c. d. q. allUnitEq c d * = q, z. ind[T](z'. allUnitEq z' z' * = refl, refl, z), a, b, p)

unitPathEquiv : (a, b : T) -> isqequiv (a = b) T
unitPathEquiv a b := (\(p : a = b). *, allUnitEq a b, \(a : T). idSymm (uniqT a), \(p : a = b). unitPathEquivLemma p)

#type unitPathEquiv

isProp : U -> U
isProp P := (a, b : P) -> a = b

isSet : U -> U
isSet S := (a, b : S) -> (p, q : a = b) -> p = q

#eval isProp
#eval isSet

equivProps : {P, Q : U} -> isProp P -> isProp Q -> (iff P Q) -> isqequiv P Q
equivProps h h' (f, g) := (f, g, \q. h' (f (g q)) q, \p. h (g (f p)) p)

#type equivProps

inhabitedPropContractable : {P : U} -> isProp P -> (p : P) -> isqequiv P T
inhabitedPropContractable h p := (\p. *, \u. p, \u. pInv (uniqT u), \a. h p a)

#type inhabitedPropContractable

-- Classical logic

isDecidable : U -> U
isDecidable A := A + not A

LEM := (A : U) -> isProp A -> isDecidable A
LDG := (A : U) -> isProp A -> not (not A) -> A
