-- Identity
id : {A : U} -> A -> A
id a := a

#check id 32

-- Projections
dfst : {A : U} -> {B : A -> U} -> (a : A) x B a -> A
dfst (a, b) := a

#type dfst

dsnd : {A : U} -> {B : A -> U} -> (p : (a : A) x B a) -> B (dfst p)
dsnd (a, b) := b

#type dsnd

fst : {A, B : U} -> A x B -> A
fst p := dfst p

#check fst (*, 32)

snd : {A, B : U} -> A x B -> B
snd p := dsnd p

#check snd (*, 32)

-- Composition
comp : {A, B, C : U} -> (B -> C) -> (A -> B) -> A -> C
comp g f a := g (f a)

#type comp

flip : {A, B, C : U} -> (A -> B -> C) -> B -> A -> C
flip f b a := f a b

-- Finite types
Fin : Nat -> U
Fin 0       := T
Fin succ(n) := (Fin n) + T

fmax : (n : Nat) -> Fin n
fmax 0       := *
fmax succ(n) := inr(*)
