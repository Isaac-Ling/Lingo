-- Based path induction
basedPathInduction : {A : U} -> {a : A} -> (C : (b : A) -> a = b -> U) -> (c : C a refl) -> (b : A) -> (p : a = b) -> C b p
basedPathInduction C c b p := ind[=[A]](a. b. p. (C : (b : A) -> a = b -> U) -> C a refl -> C b p, z. \C. \d. d, a, b, p) C c

#type basedPathInduction

-- Identity Equivalence Relation
idRefl : {A : U} -> (a : A) -> a = a
idRefl a := refl

#check idRefl

idSymm : {A : U} -> {a : A} -> {b : A} -> a = b -> b = a
idSymm p := ind[=[A]](a. b. p. b = a, z. refl, a, b, p) 

#check idSymm

idTransLemma : {A : U} -> {a : A} -> {b : A} -> a = b -> (c : A) -> b = c -> a = c
idTransLemma p := ind[=[A]](a. b. p. (c : A) -> b = c -> a = c, z. \c. \q. ind[=[A]](a. c. p. a = c, z'. refl, z, c, q), a, b, p)

idTrans : {A : U} -> {a : A} -> {b : A} -> {c : A} -> a = b -> b = c -> a = c
idTrans p := idTransLemma {A} {a} {b} p c

#check idTrans

lPathId : {A : U} -> {a : A} -> {b : A}  -> (p : a = b) -> idTrans refl p = p
lPathId p := ind[=[A]](a. b. p. idTrans refl p = p, z. refl[refl[z]], a, b, p)

#type lPathId

rPathId : {A : U} -> {a : A} -> {b : A}  -> (p : a = b) -> idTrans p refl = p
rPathId p := ind[=[A]](a. b. p. idTrans p refl = p, z. refl[refl[z]], a, b, p)

#type rPathId

-- Inverse path alias
pathInv := idSymm

reflInv : {A : U} -> (a : A) -> pathInv refl[a] = refl[a]
reflInv a := refl 

#type reflInv

lPathInv : {A : U} -> {a : A} -> {b : A} -> (p : a = b) -> idTrans (pathInv p) p = refl
lPathInv p := ind[=[A]](a. b. p. idTrans (pathInv p) p = refl, z. refl[refl[z]], a, b, p)

#type lPathInv

rPathInv : {A : U} -> {a : A} -> {b : A} -> (p : a = b) -> idTrans p (pathInv p) = refl
rPathInv p := ind[=[A]](a. b. p. idTrans p (pathInv p) = refl, z. refl[refl[z]], a, b, p)

#type rPathInv

pathInvInv : {A : U} -> {a : A} -> {b : A} -> (p : a = b) -> pathInv (pathInv p) = p
pathInvInv p := ind[=[A]](a. b. p. pathInv (pathInv p) = p, z. refl[refl[z]], a, b, p)

#type pathInvInv

pathAssocLemma2 : {A : U} -> (c : A) -> (d : A) -> (r : c = d) -> idTrans refl (idTrans refl r) = idTrans refl r
pathAssocLemma2 c d r := ind[=[A]](c. d. r. idTrans refl (idTrans refl r) = idTrans refl r, z. refl, c, d, r)

pathAssocLemma1 : {A : U} -> (a : A) -> (c : A) -> (q : a = c) -> (d : A) -> (r : c = d) -> idTrans refl (idTrans q r) = idTrans (idTrans refl q) r
pathAssocLemma1 a c q := ind[=[A]](a. c. q. (d : A) -> (r : c = d) -> idTrans refl (idTrans q r) = idTrans (idTrans refl q) r, z. pathAssocLemma2 z, a, c, q)

pathAssocLemma : {A : U} -> {a : A} -> {b : A} -> (p : a = b) -> (c : A) -> (q : b = c) -> (d : A) -> (r : c = d) -> idTrans p (idTrans q r) = idTrans (idTrans p q) r
pathAssocLemma p := ind[=[A]](a. b. p. (c : A) -> (q : b = c) -> (d : A) -> (r : c = d) -> idTrans p (idTrans q r) = idTrans (idTrans p q) r, z. pathAssocLemma1 z, a, b, p)

pathAssoc : {A : U} -> {a : A} -> {b : A} -> {c : A} -> {d : A} -> (p : a = b) -> (q : b = c) -> (r : c = d) -> idTrans p (idTrans q r) = idTrans (idTrans p q) r
pathAssoc p q := pathAssocLemma p c q d

#type pathAssoc

-- Functoriality of functions
lift : {A : U} -> {B : U} -> {a : A} -> {b : A} -> (f : A -> B) -> a = b -> f a = f b
lift f p := ind[=[A]](a. b. p. f a = f b, z. refl, a, b, p)

#check lift

-- Transport
transport : {A : U} -> {a : A} -> {b : A} -> (P : A -> U) -> a = b -> P a -> P b
transport P p := ind[=[A]](a. b. p. P a -> P b, z. id, a, b, p)

#check transport

-- Identity on type constructors
productPath : {A : U} -> {B : U} -> (a : A x B) -> (b : A x B) -> (p : a = b) -> (fst a = fst b)
productPath a b p := lift fst p

#type productPath

productUniqueness : {A : U} -> {B : U} -> (z : A x B) -> z = (fst z, snd z)
productUniqueness (a, b) := refl

#type productUniqueness
