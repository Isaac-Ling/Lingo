-- Identity
id : {A : U} -> A -> A
id a := a

-- Projections
dfst : {A : U} -> {B : A -> U} -> (a : A) x B a -> A
dfst (a, b) := a

dsnd : {A : U} -> {B : A -> U} -> (p : (a : A) x B a) -> B (dfst p)
dsnd (a, b) := b

fst : {A, B : U} -> A x B -> A
fst p := dfst p

snd : {A, B : U} -> A x B -> B
snd p := dsnd p

-- Composition
comp : {A, B, C : U} -> (B -> C) -> (A -> B) -> A -> C
comp g f a := g (f a)

flip : {A, B, C : U} -> (A -> B -> C) -> B -> A -> C
flip f b a := f a b
